# apps/admin – environment variables (Vercel project: tahara-admin)
# Separate Vercel project, separate domain, separate variables. Never share values with apps/web.

# Stage 1 skeleton: the admin UI is locked (404) unless this is exactly "true".
# Enable ONLY on local/preview deployments for design review. Keep unset in production.
ADMIN_PREVIEW_ENABLED=false

# --- Planned for stage 2/7 (do NOT set yet) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The admin app will NEVER receive SUPABASE_SERVICE_ROLE_KEY. All admin actions go through
# restricted RPCs (is_admin() + MFA aal2) – see docs/authorization.md.

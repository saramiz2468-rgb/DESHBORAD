# apps/web – environment variables (Vercel project: tahara-web)
# Stage 1 needs no secrets. Copy to .env.local for local overrides.

# Public canonical URL of the web app (used for metadata). Optional in stage 1.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Register the service worker in `next dev` as well (default: production only).
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false

# --- Planned for stage 2 (do NOT set yet) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Planned for stage 6, server-only, never NEXT_PUBLIC_ ---
# PAYMENT_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=   (webhook handler only)
